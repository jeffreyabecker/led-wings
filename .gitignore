# Python test artifacts
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.pytest-deps/
.pytest-deps/**/
pytest-cache-files-*/

# Python virtualenvs + build artifacts
.venv/
venv/
*.egg-info/
pip-wheel-metadata/
.ipynb_checkpoints/

# Local scratch (bootstrap/temp)
.tmp-pip/

# KiCad local history (auto-generated per-project snapshots)
**/.history/

# KiCad project-local UI settings (auto-generated)
*.kicad_prl

# KiCad auto-backup folders + lock files (auto-generated)
*-backups/
*.lck

# Generated KiCad schematics (build artifacts — regenerate via tools/gen_schematic.py)
boards/2020-leds/schematics/*.kicad_sch

# As-built scratch: regenerable QC rasters (overlay/gridcheck/mask PNGs, ~15 MB each).
# The geometry the script writes to as-built/outlines/ IS tracked -- see the templates README.
mechanical/templates/as-built/scratch/

# Feather print intermediates (regenerated by make_feather_sheets.py; the merged
# PDF at print/feathers-letter-landscape.pdf IS tracked).
mechanical/templates/print/sheets/
mechanical/templates/print/contact-sheet.png

mechanical/templates/reference_feathers_no_scale.xcf
mechanical/templates/eagle-feathers_color_no_scale.png