# Python test artifacts
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.pytest-deps/
.pytest-deps/**/
pytest-cache-files-*/

# Python virtualenvs + build artifacts
.venv/
venv/
*.egg-info/
pip-wheel-metadata/
.ipynb_checkpoints/

# Local scratch (bootstrap/temp)
.tmp-pip/
.tmp/

# KiCad local history (auto-generated per-project snapshots)
**/.history/

# KiCad project-local UI settings (auto-generated)
*.kicad_prl

# KiCad auto-backup folders + lock files (auto-generated)
*-backups/
*.lck

# Generated KiCad schematics (build artifacts — regenerate via tools/gen_schematic.py)
boards/2020-leds/schematics/*.kicad_sch

# As-built scratch: regenerable QC rasters (overlay/gridcheck/mask PNGs, ~15 MB each).
# The geometry the script writes to as-built/outlines/ IS tracked -- see the templates README.
templates/as-built/scratch/

# Feather print intermediates (regenerated by make_logical_pages.py +
# pages_to_pdf.py; the merged PDF at print/feathers-letter-landscape.pdf IS
# tracked).
templates/print/sheets/
templates/print/contact-sheet.png
templates/print/logical-pages/
# Same intermediates, built from the consolidated aggregate by
# make_logical_pages_consolidated.py (kept separate so it cannot overwrite the
# known-good logical-pages/ output).
templates/print/logical-pages-consolidated/

.tmp*/